---
import { SkillData } from '../../info/SkillsData';
---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 px-2 lg:px-0 pt-2 2xl:pt-8">
  {
    SkillData.map((data) => (
      <div
        class={`flex flex-col gap-4 p-8 border rounded-2xl shadow-[inset_0_1px_3px_rgba(0,0,0,0.5)] 
          ${
            data.title === 'Frontend'
              ? 'border-cyan-500/40 bg-gradient-to-bl from-cyan-500/10 to-white/[0.015] to-50%'
              : 'border-white/10 bg-white/[0.015]'
          }`}
      >
        <div class="flex justify-between items-center">
          <h3
            class={`flex  items-center gap-2 uppercase h-6 font-mono tracking-wider font-medium ${data.title === 'Frontend' ? 'text-cyan-500' : 'text-white/90'}`}
          >
            <data.icon class="size-4 " /> {data.title}
          </h3>
          {data.highlight && (
            <span class="text-cyan-500 font-mono tracking-tight bg-cyan-500/10 px-3 py-1 text-xs rounded-full border border-cyan-500/80">
              Stack principal
            </span>
          )}
        </div>
        <ul class="flex flex-wrap content-start gap-3">
          {data.items?.map((item) => (
            <li class="flex items-center gap-2 border border-white/10 bg-white/[0.015] rounded-full px-4 py-1.5 hover:border-cyan-500/60 hover:cursor-default hover:-translate-y-0.5  transition-transform duration-300">
              <item.icon class="size-5 fill-white" />
              {item.name}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
